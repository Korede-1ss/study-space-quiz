rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /loginActivity/{eventId} {
      allow read, write: if false;
    }

    match /studentLoginSummary/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
